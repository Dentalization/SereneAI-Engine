# Copy this file to .env and fill in the values as needed.
# Do not commit your real secrets.

# Required
GEMINI_API_KEY=

# Optional providers
COHERE_API_KEY=

# Logging level for the application (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Retrieval configuration
# Enable PubMed retrieval (true/false). Requires xmltodict if enabled.
ENABLE_PUBMED=false
# Embedding model for vectorization (lighter default recommended)
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings

# RAG persistence (optional; defaults are shown)
RAG_INDEX_DIR=rag/faiss_index
KG_PATH=rag/kg.pkl
