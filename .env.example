# =============================================================================
# SereneAI Engine v2.0 - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider API Keys (Required)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Optional: Claude fallback
OPENAI_API_KEY=your_openai_api_key_here        # Optional: GPT models

# -----------------------------------------------------------------------------
# LangSmith Observability (Highly Recommended for Production)
# -----------------------------------------------------------------------------
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sereneai-teledentistry
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Production: PostgreSQL (Required for durable execution)
POSTGRES_URL=postgresql://user:password@localhost:5432/sereneai_db
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Development: SQLite (For testing only)
SQLITE_PATH=.checkpoints/dev.db

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# JWT for API authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# AES encryption for sensitive data
AES_ENCRYPTION_KEY=your_32_byte_aes_key_base64_encoded

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=100

# -----------------------------------------------------------------------------
# RAG Configuration
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
RAG_INDEX_DIR=.rag/faiss_index
KG_PATH=.rag/kg.pkl
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
ENABLE_PUBMED=false

# -----------------------------------------------------------------------------
# Vision/YOLO Configuration
# -----------------------------------------------------------------------------
YOLO_MODEL_PATH=models/oral_detection_model.pt
YOLO_CONFIDENCE_THRESHOLD=0.3
YOLO_DEVICE=cpu  # or 'cuda' for GPU

# -----------------------------------------------------------------------------
# Clinical Configuration
# -----------------------------------------------------------------------------
LANGUAGE=id  # Indonesian default (id or en)
EMERGENCY_KEYWORDS=darurat,emergency,sakit_hebat,perdarahan,trauma
SOCRATES_COMPLETENESS_THRESHOLD=5
MAX_CONVERSATION_TURNS=50

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/sereneai.log
LOG_ROTATION_SIZE_MB=10
LOG_RETENTION_DAYS=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=["jpg", "jpeg", "png"]

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_APPOINTMENT_BOOKING=false
ENABLE_MEDICATION_CHECKER=false
ENABLE_REFERRAL_SYSTEM=false
ENABLE_DIFFERENTIAL_DIAGNOSIS=true
ENABLE_TREATMENT_PLANNING=true

# -----------------------------------------------------------------------------
# Middleware Configuration
# -----------------------------------------------------------------------------
# PII Protection
ENABLE_PII_DETECTION=true
PII_REDACTION_STRATEGY=mask  # redact, mask, hash, block

# Guardrails
ENABLE_CONTENT_SAFETY=true
ENABLE_JAILBREAK_DETECTION=true
ENABLE_HALLUCINATION_DETECTION=true

# Human-in-the-Loop
ENABLE_HITL=false
HITL_TOOLS=["medication_checker", "referral"]

# -----------------------------------------------------------------------------
# Checkpointing & Durability
# -----------------------------------------------------------------------------
CHECKPOINT_MODE=async  # sync, async, or exit
CHECKPOINT_CLEANUP_DAYS=90

# -----------------------------------------------------------------------------
# Monitoring & Telemetry
# -----------------------------------------------------------------------------
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_PATH=logs/audit.jsonl

# -----------------------------------------------------------------------------
# Development/Testing
# -----------------------------------------------------------------------------
ENVIRONMENT=production  # development, staging, production
DEBUG=false
RELOAD=false  # Hot reload for development
